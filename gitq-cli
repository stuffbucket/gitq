#!/usr/bin/env python3
"""gitq -- job queue whose only storage is a git repo.

  gitq init [--hub DIR] [--shards N]
  gitq enqueue TASK [--key K] [--args JSON] [--due EPOCH] [--prio N]
  gitq ls [pending|claimed|done|dead|owner|cron]
  gitq work NAME [--shards-wanted N] [--seconds S]
  gitq reap
  gitq gc
"""
import argparse
import json
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from gitq import PATTERNS, Queue, Worker                  # noqa: E402
from gitq.git import Git                                  # noqa: E402
from gitq.reaper import Reaper                            # noqa: E402
from gitq.setup_repo import init_hub, init_worker         # noqa: E402

ROOT = Path(__file__).resolve().parent / ".gitq"
CONFIG = ROOT / "config.json"


def load_cfg():
    return json.loads(CONFIG.read_text())


def open_queue(cfg, name="cli"):
    """Creates a worker object store, so only call it for commands that use one."""
    return Queue(init_worker(ROOT / "workers" / "{}.git".format(name),
                             Path(cfg["hub"])), cfg["shards"])


def main():
    ap = argparse.ArgumentParser(prog="gitq")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init")
    p_init.add_argument("--hub")
    p_init.add_argument("--shards", type=int, default=16)

    p_enq = sub.add_parser("enqueue")
    p_enq.add_argument("task")
    p_enq.add_argument("--key")
    p_enq.add_argument("--args", default="{}")
    p_enq.add_argument("--due", type=int)
    p_enq.add_argument("--prio", type=int, default=50)

    p_ls = sub.add_parser("ls")
    p_ls.add_argument("what", nargs="?", default="pending", choices=sorted(PATTERNS))

    p_work = sub.add_parser("work")
    p_work.add_argument("name")
    p_work.add_argument("--shards-wanted", type=int)
    p_work.add_argument("--seconds", type=float)

    sub.add_parser("reap")
    sub.add_parser("gc")
    a = ap.parse_args()

    if a.cmd == "init":
        hub = Path(a.hub) if a.hub else ROOT / "hub.git"
        (ROOT / "workers").mkdir(parents=True, exist_ok=True)
        init_hub(hub)
        CONFIG.write_text(json.dumps(
            {"hub": str(hub.resolve()), "shards": a.shards}, indent=2))
        print("hub:    {}\nshards: {}".format(hub, a.shards))
        return

    cfg = load_cfg()

    if a.cmd == "enqueue":
        ok = open_queue(cfg).enqueue(a.task, args=json.loads(a.args), key=a.key,
                                     due=a.due, prio=a.prio)
        print("enqueued" if ok else "already queued (idempotent no-op)")
        sys.exit(0 if ok else 3)

    if a.cmd == "ls":
        refs = open_queue(cfg).refs(a.what)
        for r in sorted(refs):
            print(r)
        print("({} {})".format(len(refs), a.what), file=sys.stderr)
        return

    if a.cmd == "work":
        def shell(args):
            cmd = args.get("cmd")
            if not cmd:
                raise ValueError("job has no 'cmd'")
            subprocess.run(cmd, shell=True, check=True)
        w = Worker(open_queue(cfg, a.name), a.name, {"shell": shell},
                   shards_wanted=a.shards_wanted)
        until = time.time() + a.seconds if a.seconds else None
        print(json.dumps(w.run(until=until), indent=2))
        return

    if a.cmd == "reap":
        print("reclaimed={} dead={}".format(*Reaper(open_queue(cfg), "cli").sweep()))
        return

    if a.cmd == "gc":
        for d in [Path(cfg["hub"])] + sorted((ROOT / "workers").glob("*.git")):
            g = Git(d)
            # NOT --prune=now: job blobs are reachable only from their refs, so
            # aggressive pruning can delete an object a worker has pushed but
            # not yet pointed a ref at. The default grace period is the point.
            g.run("gc", "--quiet")
            g.run("pack-refs", "--all")
            print("gc {}".format(d))
        return


if __name__ == "__main__":
    main()
